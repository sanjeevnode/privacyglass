#include <winver.h>

// Lowest-numbered icon resource becomes the exe's shell icon.
1 ICON "@CMAKE_SOURCE_DIR@/assets/icons/app.ico"

// CREATEPROCESS_MANIFEST_RESOURCE_ID (1): comctl32 v6 + PerMonitorV2 DPI.
1 24 "@CMAKE_SOURCE_DIR@/src/app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @VER_MAJOR@,@VER_MINOR@,@VER_PATCH@,0
 PRODUCTVERSION @VER_MAJOR@,@VER_MINOR@,@VER_PATCH@,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "WhatsApp Privacy"
            VALUE "FileDescription",  "WhatsApp Privacy"
            VALUE "FileVersion",      "@APP_VERSION_FULL@.0"
            VALUE "InternalName",     "WhatsAppPrivacy"
            VALUE "OriginalFilename", "WhatsAppPrivacy.exe"
            VALUE "ProductName",      "WhatsApp Privacy"
            VALUE "ProductVersion",   "@APP_VERSION_FULL@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
